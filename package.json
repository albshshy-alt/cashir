{
  "name": "shop-app-desktop",
  "version": "1.0.20",
  "description": "تطبيق إدارة ومبيعات المتجر باللغة العربية",
  "main": "main.js",
  "author": "Yusuf elbeses",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:updater": "electron-builder --projectDir updater-app --config updater-builder.yml --win nsis --x64",
    "dist": "electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.shopapp.desktop",
    "productName": "متجر المبيعات",
    "artifactName": "Shop-App-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "main.js",
      "preload.js",
      "COPYRIGHT-Yusuf-elbeses.txt",
      "icon.*",
      "icon-source.png"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "albshshy-alt",
      "repo": "cashir",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "متجر المبيعات"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
